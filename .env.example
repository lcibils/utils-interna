# Copiar este archivo como .env y completar con los valores reales.
# Este archivo NO contiene credenciales — es seguro commitearlo al repositorio.
# El archivo .env (con valores reales) está en .gitignore y NO debe commitearse.

AD_SERVER=dc01.empresa.local
AD_PORT=636
AD_DOMAIN=EMPRESA
AD_BASE_DN=DC=empresa,DC=local
AD_USE_SSL=true
